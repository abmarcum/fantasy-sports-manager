# =========================================================
# Yahoo Fantasy Football Graph Manager Configuration
# Copy this file to .env and replace with your credentials
# =========================================================

# Yahoo Developer App Credentials
# Create your app at https://developer.yahoo.com/apps/
YAHOO_CLIENT_ID=your_yahoo_client_id_here
YAHOO_CLIENT_SECRET=your_yahoo_client_secret_here
YAHOO_REDIRECT_URI=http://localhost:5000/api/auth/callback
# Yahoo OAuth Scope: 'fspt-r' (Fantasy Sports Read, recommended) or 'fspt-w' (Read/Write)
YAHOO_OAUTH_SCOPE=fspt-r

# Graph Database Selection ('kuzu' or 'neo4j')
DB_ENGINE=kuzu
KUZU_DB_PATH=/app/data/fantasy_graph.kuzu

# Neo4j Settings (Only required if DB_ENGINE=neo4j)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# Web Server Settings
PORT=5000
DEBUG=false
